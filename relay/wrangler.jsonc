{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "team-ai-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-17",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.01
  },
  "durable_objects": {
    "bindings": [
      { "name": "TEAM_RELAY", "class_name": "TeamRelay" },
      { "name": "INVITE_CODES", "class_name": "InviteCodeRegistry" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["TeamRelay"] },
    { "tag": "v2", "new_sqlite_classes": ["InviteCodeRegistry"] }
  ]
}
