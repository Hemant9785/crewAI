rules_version = '2';

// crewAI team data. Membership documents are the source of truth for access.
// Repository files are never stored here; only team records and bounded answers.
// Every event time is the server's time (request.time), so laptops with wrong clocks
// cannot hide events from each other or pin messages to the top of a list.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function teamPath(teamId) { return /databases/$(database)/documents/teams/$(teamId); }
    function memberPath(teamId, uid) { return /databases/$(database)/documents/teams/$(teamId)/members/$(uid); }
    function namePath(teamId, n) { return /databases/$(database)/documents/teams/$(teamId)/names/$(n); }
    function invitePath(code) { return /databases/$(database)/documents/invites/$(code); }
    function ticketPath(uid) { return /databases/$(database)/documents/joinTickets/$(uid); }
    function threadPath(teamId, id) { return /databases/$(database)/documents/teams/$(teamId)/threads/$(id); }

    function isMember(teamId) { return signedIn() && exists(memberPath(teamId, request.auth.uid)); }
    function me(teamId) { return get(memberPath(teamId, request.auth.uid)).data; }
    function isManager(teamId) { return isMember(teamId) && me(teamId).role == 'manager'; }
    function okText(v, max) { return v is string && v.size() > 0 && v.size() <= max; }
    function okName(v) { return v is string && v.matches('^[A-Za-z0-9_.-]{1,40}$'); }
    function changed(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }
    function serverTime(v) { return v == request.time; }

    function inviteOk(teamId, code) {
      return code is string && code.matches('^[0-9]{6}$')
        && get(invitePath(code)).data.teamId == teamId
        && get(invitePath(code)).data.used == false
        && get(invitePath(code)).data.expiresAt > request.time.toMillis()
        && getAfter(invitePath(code)).data.used == true;
    }

    // A new invite written by a manager of the team it is for.
    function newInviteOk(code) {
      return signedIn() && code.matches('^[0-9]{6}$')
        && request.resource.data.keys().hasOnly(['teamId', 'createdBy', 'expiresAt', 'used'])
        && isManager(request.resource.data.teamId)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.used == false
        && request.resource.data.expiresAt is number
        && request.resource.data.expiresAt > request.time.toMillis()
        && request.resource.data.expiresAt <= request.time.toMillis() + 900000;
    }

    // Before reading an invite, a joiner records which code they are trying, at most once every
    // two seconds per account. This keeps anyone from scanning the six-digit code space.
    match /joinTickets/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['code', 'at'])
        && request.resource.data.code is string && request.resource.data.code.matches('^[0-9]{6}$')
        && serverTime(request.resource.data.at);
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['code', 'at'])
        && request.resource.data.code is string && request.resource.data.code.matches('^[0-9]{6}$')
        && serverTime(request.resource.data.at)
        && request.time > resource.data.at + duration.value(2, 's');
    }

    // Invite codes: a manager creates one; a joiner claims it once, in the same write that adds them
    // to the team. Expired or used codes can be reissued, so the code space never runs out.
    match /invites/{code} {
      allow get: if signedIn() && code.matches('^[0-9]{6}$')
        && get(ticketPath(request.auth.uid)).data.code == code;
      allow create: if newInviteOk(code);
      allow update: if
        // reissue a code that is no longer live
        ((resource.data.used == true || resource.data.expiresAt <= request.time.toMillis()) && newInviteOk(code))
        ||
        // claim it while joining: only together with creating your own membership with this code
        (signedIn()
          && resource.data.used == false
          && resource.data.expiresAt > request.time.toMillis()
          && changed(['used'])
          && request.resource.data.used == true
          && !exists(memberPath(resource.data.teamId, request.auth.uid))
          && existsAfter(memberPath(resource.data.teamId, request.auth.uid))
          && getAfter(memberPath(resource.data.teamId, request.auth.uid)).data.inviteCode == code);
    }

    match /teams/{teamId} {
      allow get: if isMember(teamId);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['name', 'ownerUid', 'createdAt', 'taskSeq'])
        && request.resource.data.ownerUid == request.auth.uid
        && okText(request.resource.data.name, 40)
        && request.resource.data.taskSeq == 0
        && request.resource.data.createdAt is number;
      // Task numbers: one transaction may reserve up to 8 numbers (one per assignee).
      allow update: if isMember(teamId)
        && changed(['taskSeq'])
        && request.resource.data.taskSeq > resource.data.taskSeq
        && request.resource.data.taskSeq <= resource.data.taskSeq + 8;

      // Reserved display names (lower case). Only written together with the matching membership.
      match /names/{n} {
        allow read: if isMember(teamId);
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['uid', 'name'])
          && request.resource.data.uid == request.auth.uid
          && okName(request.resource.data.name)
          && n == request.resource.data.name.lower()
          && existsAfter(memberPath(teamId, request.auth.uid))
          && getAfter(memberPath(teamId, request.auth.uid)).data.name == request.resource.data.name;
        // Released only together with the membership it belongs to.
        allow delete: if isMember(teamId)
          && (resource.data.uid == request.auth.uid || isManager(teamId))
          && !existsAfter(memberPath(teamId, resource.data.uid));
      }

      match /members/{uid} {
        allow read: if isMember(teamId);
        allow create: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['name', 'role', 'lastSeen', 'agent', 'project', 'joinedAt', 'inviteCode'])
          && okName(request.resource.data.name)
          && serverTime(request.resource.data.lastSeen)
          && serverTime(request.resource.data.joinedAt)
          && request.resource.data.agent == null
          && request.resource.data.project == ''
          && existsAfter(namePath(teamId, request.resource.data.name.lower()))
          && getAfter(namePath(teamId, request.resource.data.name.lower())).data.uid == uid
          && (
            (request.resource.data.role == 'manager'
              && !exists(teamPath(teamId))
              && getAfter(teamPath(teamId)).data.ownerUid == uid)
            ||
            (request.resource.data.role == 'member'
              && inviteOk(teamId, request.resource.data.inviteCode))
          );
        allow update: if
          // presence, by the member themself
          (signedIn() && request.auth.uid == uid
            && changed(['lastSeen', 'agent', 'project'])
            && serverTime(request.resource.data.lastSeen)
            && (request.resource.data.agent == null || request.resource.data.agent in ['codex', 'claude'])
            && request.resource.data.project is string
            && request.resource.data.project.size() <= 120)
          ||
          // a manager makes someone else a manager
          (isManager(teamId) && request.auth.uid != uid
            && changed(['role'])
            && resource.data.role == 'member'
            && request.resource.data.role == 'manager');
        // Leave (yourself) or remove (a manager). The team owner cannot be removed, and the name
        // reservation must be released in the same write.
        allow delete: if isMember(teamId)
          && (request.auth.uid == uid || isManager(teamId))
          && uid != get(teamPath(teamId)).data.ownerUid
          && !existsAfter(namePath(teamId, resource.data.name.lower()));
      }

      match /broadcasts/{id} {
        allow read: if isMember(teamId);
        allow create: if isMember(teamId)
          && request.resource.data.keys().hasOnly(['fromUid', 'fromName', 'text', 'createdAt'])
          && request.resource.data.fromUid == request.auth.uid
          && request.resource.data.fromName == me(teamId).name
          && okText(request.resource.data.text, 2000)
          && serverTime(request.resource.data.createdAt);
      }

      match /tasks/{id} {
        allow read: if isMember(teamId);
        allow create: if isMember(teamId)
          && request.resource.data.keys().hasOnly(['num', 'assigneeUid', 'assigneeName', 'assignerUid', 'assignerName', 'text', 'status', 'note', 'createdAt', 'updatedAt'])
          && request.resource.data.assignerUid == request.auth.uid
          && request.resource.data.assignerName == me(teamId).name
          && exists(memberPath(teamId, request.resource.data.assigneeUid))
          && get(memberPath(teamId, request.resource.data.assigneeUid)).data.name == request.resource.data.assigneeName
          && okText(request.resource.data.text, 2000)
          && request.resource.data.status == 'todo'
          && request.resource.data.note == ''
          && serverTime(request.resource.data.createdAt)
          && serverTime(request.resource.data.updatedAt)
          && request.resource.data.num is int
          && request.resource.data.num > get(teamPath(teamId)).data.taskSeq
          && request.resource.data.num <= getAfter(teamPath(teamId)).data.taskSeq;
        allow update: if isMember(teamId)
          && (resource.data.assigneeUid == request.auth.uid
              || resource.data.assignerUid == request.auth.uid
              || isManager(teamId))
          && changed(['status', 'note', 'updatedAt'])
          && request.resource.data.status in ['todo', 'in_progress', 'done', 'cancelled', 'needs_help']
          && request.resource.data.note is string
          && request.resource.data.note.size() <= 300
          && serverTime(request.resource.data.updatedAt);
      }

      // A question has exactly one owner at a time. Only the asker, the current target
      // and previous targets (so they can learn it moved) can read it.
      // Private conversations: follow-up questions about a task and pull request reviews. Only the people
      // listed in `participants` (and only while they are still team members) can read or write them. They are
      // never part of the team-wide feed. The latest message is copied onto the thread for lists and alerts.
      match /threads/{threadId} {
        allow read: if isMember(teamId) && request.auth.uid in resource.data.participants;
        allow create: if isMember(teamId)
          && request.resource.data.keys().hasOnly(['kind', 'taskId', 'taskNum', 'title', 'prUrl', 'createdByUid', 'createdByName', 'participants', 'participantNames', 'status', 'lastText', 'lastFromUid', 'lastFromName', 'lastVerdict', 'createdAt', 'updatedAt'])
          && request.resource.data.kind in ['followup', 'review']
          && request.resource.data.createdByUid == request.auth.uid
          && request.resource.data.createdByName == me(teamId).name
          && request.resource.data.participants is list
          && request.resource.data.participants.size() >= 2
          && request.resource.data.participants.size() <= 20
          && request.auth.uid in request.resource.data.participants
          && request.resource.data.participantNames is list
          && request.resource.data.participantNames.size() == request.resource.data.participants.size()
          && okText(request.resource.data.title, 200)
          && request.resource.data.taskId is string && request.resource.data.taskId.size() <= 40
          && request.resource.data.taskNum is int && request.resource.data.taskNum >= 0
          && ((request.resource.data.kind == 'followup' && request.resource.data.prUrl == '')
              || (request.resource.data.kind == 'review' && request.resource.data.prUrl.matches('^https://[^ ]{4,490}$')))
          && request.resource.data.status == 'open'
          && request.resource.data.lastFromUid == request.auth.uid
          && request.resource.data.lastFromName == me(teamId).name
          && request.resource.data.lastText is string && request.resource.data.lastText.size() <= 200
          && request.resource.data.lastVerdict == ''
          && serverTime(request.resource.data.createdAt)
          && serverTime(request.resource.data.updatedAt);
        allow update: if isMember(teamId)
          && request.auth.uid in resource.data.participants
          && (
            // the person who started it closes or reopens it
            (changed(['status'])
              && request.resource.data.status in ['open', 'closed']
              && resource.data.createdByUid == request.auth.uid)
            ||
            // a participant posts a message while it is open (the thread records the latest one)
            (changed(['updatedAt', 'lastText', 'lastFromUid', 'lastFromName', 'lastVerdict'])
              && resource.data.status == 'open'
              && request.resource.data.lastFromUid == request.auth.uid
              && request.resource.data.lastFromName == me(teamId).name
              && request.resource.data.lastText is string && request.resource.data.lastText.size() <= 200
              && request.resource.data.lastVerdict in ['', 'approved', 'changes', 'comment']
              && serverTime(request.resource.data.updatedAt))
          );

        match /messages/{messageId} {
          allow read: if isMember(teamId) && request.auth.uid in get(threadPath(teamId, threadId)).data.participants;
          allow create: if isMember(teamId)
            && request.auth.uid in getAfter(threadPath(teamId, threadId)).data.participants
            && request.resource.data.keys().hasOnly(['fromUid', 'fromName', 'text', 'verdict', 'createdAt'])
            && request.resource.data.fromUid == request.auth.uid
            && request.resource.data.fromName == me(teamId).name
            && okText(request.resource.data.text, 2000)
            && request.resource.data.verdict in ['', 'approved', 'changes', 'comment']
            // only a reviewer (not the author) of a review can attach a verdict
            && (request.resource.data.verdict == ''
                || (getAfter(threadPath(teamId, threadId)).data.kind == 'review'
                    && getAfter(threadPath(teamId, threadId)).data.createdByUid != request.auth.uid))
            && (!exists(threadPath(teamId, threadId)) || get(threadPath(teamId, threadId)).data.status == 'open')
            && serverTime(request.resource.data.createdAt);
        }
      }

      match /requests/{id} {
        allow read: if isMember(teamId)
          && (resource.data.askerUid == request.auth.uid
              || resource.data.targetUid == request.auth.uid
              || request.auth.uid in resource.data.movedFrom);
        allow create: if isMember(teamId)
          && request.resource.data.keys().hasOnly(['askerUid', 'askerName', 'targetUid', 'targetName', 'question', 'status', 'answer', 'agent', 'error', 'movedFrom', 'createdAt', 'updatedAt'])
          && request.resource.data.askerUid == request.auth.uid
          && request.resource.data.askerName == me(teamId).name
          && exists(memberPath(teamId, request.resource.data.targetUid))
          && get(memberPath(teamId, request.resource.data.targetUid)).data.name == request.resource.data.targetName
          && okText(request.resource.data.question, 2000)
          && request.resource.data.status == 'pending'
          && request.resource.data.answer == ''
          && request.resource.data.agent == ''
          && request.resource.data.error == ''
          && request.resource.data.movedFrom.size() == 0
          && serverTime(request.resource.data.createdAt)
          && serverTime(request.resource.data.updatedAt);
        allow update: if isMember(teamId) && serverTime(request.resource.data.updatedAt) && (
          // asker moves a still-pending question to someone else
          (resource.data.askerUid == request.auth.uid
            && resource.data.status == 'pending'
            && changed(['targetUid', 'targetName', 'movedFrom', 'updatedAt'])
            && exists(memberPath(teamId, request.resource.data.targetUid))
            && get(memberPath(teamId, request.resource.data.targetUid)).data.name == request.resource.data.targetName
            && request.resource.data.movedFrom == resource.data.movedFrom.concat([resource.data.targetUid]))
          ||
          // asker cancels
          (resource.data.askerUid == request.auth.uid
            && resource.data.status in ['pending', 'running']
            && changed(['status', 'updatedAt'])
            && request.resource.data.status == 'cancelled')
          ||
          // current target consents, answers, declines or fails
          (resource.data.targetUid == request.auth.uid
            && resource.data.status in ['pending', 'running']
            && changed(['status', 'answer', 'agent', 'error', 'updatedAt'])
            && request.resource.data.status in ['running', 'answered', 'declined', 'failed']
            && (request.resource.data.status != 'running' || resource.data.status == 'pending')
            && request.resource.data.answer is string && request.resource.data.answer.size() <= 8000
            && request.resource.data.agent is string && request.resource.data.agent.size() <= 20
            && request.resource.data.error is string && request.resource.data.error.size() <= 300)
        );
      }
    }
  }
}
