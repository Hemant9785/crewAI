# Firebase web app config (Project settings > General > Your apps). These are public identifiers, not secrets.
CREWAI_FIREBASE_API_KEY=
CREWAI_FIREBASE_AUTH_DOMAIN=
CREWAI_FIREBASE_PROJECT_ID=
CREWAI_FIREBASE_APP_ID=
# Set to use the local emulators instead of a real project, e.g. 127.0.0.1:8080 and 127.0.0.1:9099
# CREWAI_FIRESTORE_EMULATOR=127.0.0.1:8080
# CREWAI_AUTH_EMULATOR=127.0.0.1:9099
